{
    "name": "dcag/monat7-integration",
    "description": "Monat 7 - Integration Testing mit Codeception (eigene Integration-Suite, kein Framework)",
    "type": "project",
    "require": { "php": "^8.2", "ext-pdo": "*", "ext-pdo_sqlite": "*" },
    "require-dev": {
        "codeception/codeception": "^5.0",
        "codeception/module-asserts": "^3.0"
    },
    "autoload": { "psr-4": { "App\\": "src/" } },
    "autoload-dev": { "psr-4": { "Tests\\": "tests/Support/" } }
}
